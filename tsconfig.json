{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["index.ts", "types.ts", "smoke.ts", "core.ts", "seconds.ts", "config.ts", "metadata.ts", "runtime.ts", "tui.tsx", "state.ts", "bin/**/*.ts"]
}
